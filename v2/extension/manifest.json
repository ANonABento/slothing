{
  "manifest_version": 3,
  "name": "Slothing",
  "version": "0.2.0",
  "description": "Notices job postings and application forms as you browse, saves them to Slothing, and fills applications from your profile and answer bank.",
  "action": { "default_title": "Slothing" },
  "side_panel": { "default_path": "panel.html" },
  "background": { "service_worker": "background.js" },
  "icons": { "128": "icon.png" },
  "permissions": ["scripting", "storage", "sidePanel"],
  "host_permissions": ["<all_urls>"],
  "content_scripts": [
    { "matches": ["<all_urls>"], "js": ["watch.js"], "run_at": "document_idle" },
    { "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["pair.js"], "run_at": "document_idle" }
  ],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" } } }
}
