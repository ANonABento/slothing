{
  "manifest_version": 3,
  "name": "Slothing",
  "version": "0.1.0",
  "description": "Save job postings to Slothing, and fill applications from your profile and answer bank.",
  "action": { "default_popup": "popup.html", "default_title": "Slothing" },
  "icons": { "128": "icon.png" },
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*"],
  "optional_host_permissions": ["<all_urls>"],
  "content_scripts": [{ "matches": ["http://localhost/*", "http://127.0.0.1/*"], "js": ["pair.js"], "run_at": "document_idle" }],
  "commands": { "_execute_action": { "suggested_key": { "default": "Alt+Shift+S" } } }
}
