# One of these is required for import / tailoring. First one set wins:
# Anthropic → Nebius → OpenAI(-compatible).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-5-5

# Nebius AI Studio (OpenAI-compatible)
NEBIUS_API_KEY=
NEBIUS_MODEL=moonshotai/Kimi-K3
NEBIUS_BASE_URL=https://api.studio.nebius.com/v1

OPENAI_API_KEY=
OPENAI_MODEL=gpt-5
# Any OpenAI-compatible endpoint (OpenRouter, LM Studio, Ollama /v1, ...)
OPENAI_BASE_URL=
